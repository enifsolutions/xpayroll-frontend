import TransportTab from "@/components/employees/TransportTab";
import QualificationsTab from "@/components/employees/QualificationsTab";
import DocumentsTab from "@/components/employees/DocumentsTab";
import ProfileCompletion from "@/components/employees/ProfileCompletion";
